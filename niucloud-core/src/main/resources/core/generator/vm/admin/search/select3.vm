#set($mapper = $generateService.getMapperInfo($column.model))
<el-form-item :label="t('${lowerColumnName}')" prop="${column.columnName}">
    <el-select class="w-[280px]" v-model="${lowerClassName}Table.searchParam.${column.columnName}" clearable :placeholder="t('${lowerColumnName}Placeholder')">
        <el-option label="全部" value=""></el-option>
        <el-option
            v-for="(item, index) in $strUtil.lowerFirst($mapper.entityName)List"
            :key="index"
            :label="item.$column.labelKey"
            :value="item.$column.valueKey"
        />
    </el-select>
</el-form-item>