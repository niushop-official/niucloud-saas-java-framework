                                <excludes>
                                </excludes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.test.shade.test</pattern>
                                    <shadedPattern>com.test.shade.test.launcher</shadedPattern>
                                </relocation>
                            </relocations>
