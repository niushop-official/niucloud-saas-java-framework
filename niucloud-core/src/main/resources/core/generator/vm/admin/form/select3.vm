#set($mapper = $generateService.getMapperInfo($column.model))
<el-form-item :label="t('${lowerColumnName}')" prop="${column.columnName}">
    <el-select v-model="formData.${column.columnName}" clearable :placeholder="t('${lowerColumnName}Placeholder')" class="input-width">
        <el-option label="请选择" value=""></el-option>
        #if ($column.columnType != "String")
        <el-option
            v-for="(item, index) in $strUtil.lowerFirst($mapper.entityName)List"
            :key="index"
            :label="item.$column.labelKey"
            :value="isNaN(parseInt(item.$column.valueKey)) ? item.$column.valueKey : parseInt(item.$column.valueKey)"
        />
        #else
        <el-option
            v-for="(item, index) in $strUtil.lowerFirst($mapper.entityName)List"
            :key="index"
            :label="item.$column.labelKey"
            :value="item.$column.valueKey"
        />
        #end
    </el-select>
</el-form-item>