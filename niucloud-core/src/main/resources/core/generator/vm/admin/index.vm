<template>
    <div class="main-container">
        <el-card class="box-card !border-none" shadow="never">

            <div class="flex justify-between items-center">
                <span class="text-lg">{{pageName}}</span>
                <el-button type="primary" @click="addEvent">
                    {{ t('add${className}') }}
                </el-button>
            </div>

            <el-card class="box-card !border-none my-[10px] table-search-wrap" shadow="never">
                <el-form :inline="true" :model="${lowerClassName}Table.searchParam" ref="searchFormRef">
${searchForm}
                    <el-form-item>
                        <el-button type="primary" @click="load${className}List()">{{ t('search') }}</el-button>
                        <el-button @click="resetForm(searchFormRef)">{{ t('reset') }}</el-button>
                    </el-form-item>
                </el-form>
            </el-card>

            <div class="mt-[10px]">
                <el-table :data="${lowerClassName}Table.data" size="large" v-loading="${lowerClassName}Table.loading">
                    <template #empty>
                        <span>{{ !${lowerClassName}Table.loading ? t('emptyData') : '' }}</span>
                    </template>
${listView}
                    <el-table-column :label="t('operation')" fixed="right" min-width="120">
                       <template #default="{ row }">
                           <el-button type="primary" link @click="editEvent(row)">{{ t('edit') }}</el-button>
                           <el-button type="primary" link @click="deleteEvent(row.${primaryField})">{{ t('delete') }}</el-button>
                       </template>
                    </el-table-column>

                </el-table>
                <div class="mt-[16px] flex justify-end">
                    <el-pagination v-model:current-page="${lowerClassName}Table.page" v-model:page-size="${lowerClassName}Table.limit"
                        layout="total, sizes, prev, pager, next, jumper" :total="${lowerClassName}Table.total"
                        @size-change="load${className}List()" @current-change="load${className}List" />
                </div>
            </div>

            #if ($editType == 1)
            <edit ref="edit${className}Dialog" @complete="load${className}List"/>
            #end
        </el-card>
    </div>
</template>

<script lang="ts" setup>
import { reactive, ref, watch } from 'vue'
import { t } from '@/lang'
import { useDictionary } from '@/app/api/dict'
import { get${className}List, delete${className} } from '${adminPath}/api/${moduleName}/${originalClassName}'
import { img } from '@/utils/common'
import { ElMessageBox,FormInstance } from 'element-plus'
import { useRoute } from 'vue-router'
#if ($editType == 1)
#set($componentName = $originalClassName.toLowerCase().replace("_", "-"))
import Edit from "${adminPath}/views/${moduleName}/components/${componentName}-edit.vue"
#end

const route = useRoute()
const pageName = route.meta.title
#if ($editType == 1)
const edit${className}Dialog = ref(null)
#end

let ${lowerClassName}Table = reactive({
    page: 1,
    limit: 10,
    total: 0,
    loading: true,
    data: [],
    searchParam:{
        ${searchParam}
    }
})

const searchFormRef = ref<FormInstance>()

// 选中数据
const selectData = ref<any[]>([])

// 字典数据

/**
 * 获取${notes}列表
 */
const load${className}List = (page: number = 1) => {
    ${lowerClassName}Table.loading = true
    ${lowerClassName}Table.page = page

    get${className}List({
        page: ${lowerClassName}Table.page,
        limit: ${lowerClassName}Table.limit,
         ...${lowerClassName}Table.searchParam
    }).then(res => {
        ${lowerClassName}Table.loading = false
        ${lowerClassName}Table.data = res.data.data
        ${lowerClassName}Table.total = res.data.total
    }).catch(() => {
        ${lowerClassName}Table.loading = false
    })
}
load${className}List()

/**
 * 添加${notes}
 */
const addEvent = () => {
#if ($editType == 1)
    edit${className}Dialog.value.showDialog = true
#else
    #if ($addonName.equals("core"))
        #if ($originalClassName.isEmpty())
            router.push('/${moduleName}/edit')
        #else
            router.push('/${moduleName}/${originalClassName}_edit')
        #end
    #else
        #if ($originalClassName.isEmpty())
            router.push('/${addonName}/${moduleName}/edit')
        #else
            router.push('/${addonName}/${moduleName}/${originalClassName}_edit')
        #end
    #end
#end
}

/**
 * 编辑${notes}
 * @param data
 */
const editEvent = (data: any) => {
#if ($editType == 1)
    edit${className}Dialog.value.setFormData(data)
    edit${className}Dialog.value.showDialog = true
#else
    #if ($addonName.equals("core"))
        #if ($originalClassName.isEmpty())
            router.push('/${moduleName}/edit?id=' + data.${primaryField})
        #else
            router.push('/${moduleName}/${originalClassName}_edit?id=' + data.${primaryField})
        #end
    #else
        #if ($originalClassName.isEmpty())
            router.push('/${addonName}/${moduleName}/edit?id=' + data.${primaryField})
        #else
            router.push('/${addonName}/${moduleName}/${originalClassName}_edit?id=' + data.${primaryField})
        #end
    #end
#end
}

/**
 * 删除${notes}
 */
const deleteEvent = (id: number) => {
    ElMessageBox.confirm(t('${lowerClassName}DeleteTips'), t('warning'),
        {
            confirmButtonText: t('confirm'),
            cancelButtonText: t('cancel'),
            type: 'warning',
        }
    ).then(() => {
        delete${className}(id).then(() => {
            load${className}List()
        }).catch(() => {
        })
    })
}

const resetForm = (formEl: FormInstance | undefined) => {
    if (!formEl) return
    formEl.resetFields()
    load${className}List()
}
</script>

<style lang="scss" scoped>
/* 多行超出隐藏 */
.multi-hidden {
		word-break: break-all;
		text-overflow: ellipsis;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}
</style>
