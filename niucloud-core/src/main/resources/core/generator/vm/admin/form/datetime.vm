<el-form-item :label="t('${lowerColumnName}')" prop="${column.columnName}" class="input-width">
    <el-date-picker 
        class="flex-1 !flex"
        v-model="formData.${column.columnName}"
        clearable
        type="datetime"
        value-format="YYYY-MM-DD HH:mm:ss"
        :placeholder="t('${lowerColumnName}Placeholder')">
    </el-date-picker>
</el-form-item>