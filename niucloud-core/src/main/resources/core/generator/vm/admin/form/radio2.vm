<el-form-item :label="t('${lowerColumnName}')" prop="${column.columnName}">
    <el-radio-group v-model="formData.${column.columnName}" :placeholder="t('${lowerColumnName}Placeholder')">
        #if ($column.columnType != "String")
        <el-radio
            v-for="(item, index) in $strUtil.toCamelCase($column.dictType)Dict"
            :key="index" :label="isNaN(parseInt(item.value)) ? item.value : parseInt(item.value)">
              {{ item.name }}
        </el-radio>
        #else
        <el-radio
            v-for="(item, index) in $strUtil.toCamelCase($column.dictType)Dict"
            :key="index" :label="item.value">
              {{ item.name }}
        </el-radio>
        #end
    </el-radio-group>
</el-form-item>