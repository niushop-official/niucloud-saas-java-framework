#set($mapper = $generateService.getMapperInfo($column.model))
<el-form-item :label="t('${lowerColumnName}')" prop="${column.columnName}">
    <el-checkbox-group v-model="formData.${column.columnName}" :placeholder="t('${lowerColumnName}Placeholder')">
        #if ($column.columnType != "String")
        <el-checkbox v-for="(item, index) in $strUtil.lowerFirst($mapper.entityName)List" :key="index" :label="isNaN(parseInt(item.$column.valueKey)) ? item.$column.valueKey : parseInt(item.$column.valueKey)">{{ item.$column.labelKey }}</el-checkbox>
        #else
        <el-checkbox v-for="(item, index) in $strUtil.lowerFirst($mapper.entityName)List" :key="index" :label="item.$column.valueKey">{{ item.$column.labelKey }}</el-checkbox>
        #end
    </el-checkbox-group>
</el-form-item>